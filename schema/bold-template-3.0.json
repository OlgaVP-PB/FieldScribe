{
  "standard": "BOLD / iBOL Specimen Data Submission Template",
  "version": "3.0",
  "source": "https://v3.boldsystems.org/index.php/resources/handbook?chapter=3_submissions.html",
  "unit": "One BOLD record (Sample ID) per FieldScribe tube. A specimen split across N tubes yields N BOLD records (sub-sampled Sample IDs).",
  "minimum_required": ["Sample ID", "Field ID OR Museum ID", "Institution Storing", "Phylum", "Country/Ocean"],
  "sheets": {
    "Voucher Info": ["Sample ID", "Field ID", "Museum ID", "Collection Code", "Institution Storing"],
    "Taxonomy": ["Sample ID", "Phylum", "Class", "Order", "Family", "Subfamily", "Genus", "Species", "Identifier", "Identifier Email", "Identifier Institution", "Identification Method", "Tax Notes"],
    "Specimen Details": ["Sample ID", "Sex", "Reproduction", "Life Stage", "Extra Info", "Notes", "Voucher Status", "Tissue Descriptor", "Associated Taxa", "Associated Specimens", "External URLs"],
    "Collection Data": ["Sample ID", "Collectors", "Collection Event ID", "Collection Date", "Date Accuracy", "Event Time", "Country/Ocean", "State/Province", "Region", "Sector", "Exact Site", "Site Code", "Habitat", "Sampling Protocol", "Latitude", "Longitude", "Coordinate Accuracy", "Coordinate Source", "Elevation", "Elevation Precision", "Depth", "Depth Precision", "Collection Notes"]
  },
  "controlled_vocabularies": {
    "Sex": ["female", "hermaphrodite", "male"],
    "Reproduction": ["sexual", "asexual", "cyclic parthenogenesis"],
    "Life Stage": ["Adult", "Immature", "pupa"],
    "Voucher Status": [
      "museum vouchered:type",
      "museum vouchered:type series",
      "vouchered:registered collection",
      "to be vouchered:holdup/private",
      "e-vouchered:dna/tissue+photo",
      "dna/tissue vouchered only",
      "no specimen"
    ]
  },
  "field_mapping": {
    "_comment": "BOLD column <- FieldScribe source. specimen.* = specimen-level field; tube.* = per-tube field. Transforms noted in brackets.",
    "Sample ID": "tube.collectorSampleId",
    "Field ID": "tube.collectorSampleId",
    "Museum ID": "",
    "Collection Code": "",
    "Institution Storing": "specimen.institutionStoring [new field; default = specimen.collectorAffiliation]",
    "Phylum": "specimen.phylum [new field]",
    "Class": "specimen.class [new field]",
    "Order": "specimen.order",
    "Family": "specimen.family",
    "Subfamily": "",
    "Genus": "specimen.genus",
    "Species": "specimen.scientificName",
    "Identifier": "",
    "Identifier Email": "",
    "Identifier Institution": "",
    "Identification Method": "",
    "Tax Notes": "",
    "Sex": "MAP(specimen.sex): FEMALE->female, MALE->male, HERMAPHRODITE_MONOECIOUS->hermaphrodite, else ''",
    "Reproduction": "",
    "Life Stage": "MAP(specimen.lifestage): ADULT->Adult, JUVENILE->Immature, PUPA->pupa, LARVA->Immature, EMBRYO/EGG/ZYGOTE->Immature, else '' (NOT_* -> '')",
    "Extra Info": "",
    "Notes": "",
    "Voucher Status": "",
    "Tissue Descriptor": "tube.organismPart [join with ', ', lowercase, underscores->spaces]",
    "Associated Taxa": "",
    "Associated Specimens": "",
    "External URLs": "",
    "Collectors": "specimen.collectedBy",
    "Collection Event ID": "",
    "Collection Date": "REFORMAT(specimen.date): YYYY-MM-DD -> DD-MMM-YYYY (e.g. 2023-08-22 -> 22-AUG-2023)",
    "Date Accuracy": "",
    "Event Time": "specimen.time",
    "Country/Ocean": "SPLIT(specimen.location,'|')[0] trimmed",
    "State/Province": "SPLIT(specimen.location,'|')[1] trimmed",
    "Region": "SPLIT(specimen.location,'|')[2] trimmed",
    "Sector": "SPLIT(specimen.location,'|')[3] trimmed",
    "Exact Site": "SPLIT(specimen.location,'|')[4..] joined ' | ' trimmed",
    "Site Code": "",
    "Habitat": "specimen.habitat",
    "Sampling Protocol": "specimen.method",
    "Latitude": "specimen.latitude",
    "Longitude": "specimen.longitude",
    "Coordinate Accuracy": "specimen.gpsAccuracy [if captured, numeric metres; else '']",
    "Coordinate Source": "'GPS' if coords captured via device GPS else ''",
    "Elevation": "specimen.elevation",
    "Elevation Precision": "",
    "Depth": "specimen.depth",
    "Depth Precision": "",
    "Collection Notes": ""
  }
}
